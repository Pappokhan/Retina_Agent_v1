
GOOGLE_API_KEY=
VLM_MODEL=google_genai:gemini-3.5-flash-lite
AGENT_MODEL=google_genai:gemini-3.5-flash-lite
# VLM_THINKING=low            # Gemini 3 thinking: minimal | low | medium | high (low = fast)
# VLM_FALLBACK_MODEL=google_genai:gemini-2.5-flash-lite   # used if the main model is busy




# ANTHROPIC_API_KEY=
# VLM_MODEL=anthropic:claude-sonnet-5-5
# AGENT_MODEL=anthropic:claude-sonnet-5-5

# Optional
# VLM_LANG=English            # English or Bangla
# WEIGHTS_DIR=./weights
# MODEL_CACHE_SIZE=8          # ~55 MB per cached model
# RAG_BACKEND=bm25            # or faiss (needs the optional packages)
# APP_TOKEN=                  # set to require an access token on /api/*
# RATE_LIMIT_PER_MIN=30       # VLM and chat calls per client
# UPLOAD_TTL_HOURS=6          # uploads are deleted after this
# HOST=127.0.0.1
# PORT=8000
